<Window x:Class="Handshake.Desktop.ReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Review contact" Width="620" Height="620" WindowStartupLocation="CenterOwner">
  <ScrollViewer><StackPanel Margin="22">
    <TextBlock Text="Review extracted contact" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
    <TextBlock Text="Name" /><TextBox x:Name="NameBox" Margin="0,4,0,10" />
    <TextBlock Text="Company" /><TextBox x:Name="CompanyBox" Margin="0,4,0,10" />
    <TextBlock Text="Title" /><TextBox x:Name="TitleBox" Margin="0,4,0,10" />
    <TextBlock Text="Email" /><TextBox x:Name="EmailBox" Margin="0,4,0,10" />
    <TextBlock Text="Phone" /><TextBox x:Name="PhoneBox" Margin="0,4,0,10" />
    <TextBlock Text="Website" /><TextBox x:Name="WebsiteBox" Margin="0,4,0,10" />
    <TextBlock Text="LinkedIn" /><StackPanel Orientation="Horizontal" Margin="0,4,0,10"><TextBox x:Name="LinkedInBox" Width="390" /><Button Content="Find on LinkedIn" Padding="10,4" Margin="8,0,0,0" Click="FindLinkedIn_Click" /><Button Content="Open" Padding="10,4" Margin="6,0,0,0" Click="OpenLinkedIn_Click" /></StackPanel>
    <TextBlock Text="Address" /><TextBox x:Name="AddressBox" Margin="0,4,0,14" />
    <TextBlock Text="Biography" FontWeight="SemiBold" /><TextBox x:Name="BiographyBox" Height="110" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,14" />
    <TextBlock Text="Contact photo" FontWeight="SemiBold" />
    <StackPanel Orientation="Horizontal" Margin="0,4,0,14"><Image x:Name="PhotoPreview" Width="90" Height="90" Stretch="UniformToFill" Margin="0,0,12,0" /><StackPanel VerticalAlignment="Center"><Button Content="Replace photo" Padding="12,7" Click="ReplacePhoto_Click" /><Button Content="Paste copied photo" Padding="12,7" Margin="0,7,0,0" Click="PastePhoto_Click" /><Button Content="Delete photo" Padding="12,7" Margin="0,7,0,0" Click="DeletePhoto_Click" /></StackPanel></StackPanel>
    <TextBlock Text="Personal audio note" FontWeight="SemiBold" />
    <StackPanel Orientation="Horizontal" Margin="0,4,0,14"><Button x:Name="RecordMemoButton" Content="Record" Padding="12,7" Click="RecordMemo_Click" /><TextBlock x:Name="MemoCountdown" Text="" VerticalAlignment="Center" Margin="10,0,0,0" /><Button Content="Transcribe and organize" Padding="12,7" Margin="8,0,0,0" Click="AnalyzeMemo_Click" /><ProgressBar x:Name="MemoBusyIndicator" Width="90" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
    <TextBlock Text="Private notes" /><TextBox x:Name="NotesBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,10" />
    <TextBlock Text="Follow-up" /><TextBox x:Name="FollowUpBox" Height="55" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,10" />
    <CheckBox x:Name="DoneBox" Content="Follow-up complete" Margin="0,0,0,14" />
    <TextBlock Text="Company research" FontWeight="SemiBold" /><StackPanel><StackPanel Orientation="Horizontal" Margin="0,4,0,6"><Button Content="Research company" Padding="12,7" Click="Research_Click" /><ProgressBar x:Name="ResearchBusyIndicator" Width="90" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel><TextBox x:Name="ResearchBox" Height="110" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14" /></StackPanel>
    <TextBlock Text="Raw AI response" FontWeight="SemiBold" /><TextBox x:Name="RawBox" Height="130" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,4,0,14" />
    <Button Content="Save contact" Padding="14,9" HorizontalAlignment="Right" Click="Save_Click" />
  </StackPanel></ScrollViewer>
</Window>
