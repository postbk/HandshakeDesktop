<Application x:Class="Handshake.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="ForestTeal" Color="#0F4C5C" />
    <SolidColorBrush x:Key="Navy" Color="#17324D" />
    <SolidColorBrush x:Key="Mint" Color="#E5F0F3" />
    <SolidColorBrush x:Key="Ivory" Color="#F7F9FA" />
    <SolidColorBrush x:Key="PanelBorder" Color="#D7E1E6" />
    <SolidColorBrush x:Key="MutedText" Color="#61717C" />
    <Style TargetType="Button"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#B8C8D1" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#17324D" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="12,8" /></Style>
    <Style TargetType="TextBox"><Setter Property="BorderBrush" Value="#B8C8D1" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="7" /></Style>
    <Style TargetType="ComboBox"><Setter Property="BorderBrush" Value="#B8C8D1" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="6" /></Style>
  </Application.Resources>
</Application>
