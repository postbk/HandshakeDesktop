<Application x:Class="Handshake.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="ForestTeal" Color="#08A7A5" />
    <SolidColorBrush x:Key="Navy" Color="#082F6B" />
    <SolidColorBrush x:Key="Mint" Color="#E3F5F5" />
    <SolidColorBrush x:Key="Ivory" Color="#F7FAFC" />
    <SolidColorBrush x:Key="PanelBorder" Color="#C9DDE6" />
    <SolidColorBrush x:Key="MutedText" Color="#5B6F7E" />
    <SolidColorBrush x:Key="AccentGold" Color="#F4BD4E" />
    <Style TargetType="Button"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#9BC4D2" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#082F6B" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="12,8" /></Style>
    <Style TargetType="TextBox"><Setter Property="BorderBrush" Value="#9BC4D2" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="7" /></Style>
    <Style TargetType="ComboBox"><Setter Property="BorderBrush" Value="#9BC4D2" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="6" /></Style>
  </Application.Resources>
</Application>
