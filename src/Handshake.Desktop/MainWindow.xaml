<Window x:Class="Handshake.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Handshake" Width="1100" Height="720" MinWidth="850" MinHeight="560"
        Background="{DynamicResource Ivory}" AllowDrop="True" Drop="Window_Drop">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,22">
      <StackPanel>
        <TextBlock Text="Handshake" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource ForestTeal}" />
        <TextBlock Text="Trade-show connections, organized and actionable" FontSize="15" Foreground="#60716D" Margin="0,4,0,0" />
      </StackPanel>
      <Button DockPanel.Dock="Right" Content="Settings" Padding="18,9" Margin="12,0,0,0" Click="Settings_Click" />
    </DockPanel>
    <Border Grid.Row="1" Background="{DynamicResource Mint}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="Current event" FontWeight="SemiBold" Foreground="{DynamicResource ForestTeal}" />
          <TextBlock Text="Choose an event or create one to start capturing connections." Margin="0,5,0,0" />
        </StackPanel>
        <Button DockPanel.Dock="Right" Content="New event" Padding="18,9" Click="NewEvent_Click" />
      </DockPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="#D5DFD9" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,12,0" AllowDrop="True" Drop="Window_Drop">
        <StackPanel>
          <TextBlock Text="Import images" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ForestTeal}" />
          <TextBlock Text="Bring in a business card, brochure, or fact sheet from your PC or Google Photos. You can also drag image files anywhere into this window." TextWrapping="Wrap" Margin="0,8,0,20" />
          <Button Content="Choose local images…" Padding="18,11" Click="ChooseImages_Click" />
          <Button Content="Choose from Google Photos…" Padding="18,11" Margin="0,10,0,0" Click="GooglePhotos_Click" />
          <Button Content="Save capture locally" Padding="18,11" Margin="0,10,0,0" Click="SaveCapture_Click" />
          <Button Content="Extract contact details" Padding="18,11" Margin="0,10,0,0" Click="Extract_Click" />
          <Button Content="Export contacts to CSV…" Padding="18,11" Margin="0,10,0,0" Click="Export_Click" />
          <TextBlock x:Name="StatusText" Text="No images selected yet." Foreground="#60716D" TextWrapping="Wrap" Margin="0,20,0,0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D5DFD9" BorderThickness="1" CornerRadius="12" Padding="22">
        <StackPanel>
          <TextBlock Text="Selected pages" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ForestTeal}" />
          <TextBlock Text="Images will be normalized and reviewed here before AI extraction is added." Foreground="#60716D" TextWrapping="Wrap" Margin="0,8,0,18" />
          <ListBox x:Name="ImagesList" MinHeight="120" />
          <TextBlock Text="Saved contacts" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForestTeal}" Margin="0,20,0,8" />
          <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Search saved contacts" Margin="0,0,0,8" Padding="8" />
          <ListBox x:Name="ContactsList" MinHeight="120" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
