<Window x:Class="Handshake.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Handshake" Icon="/Handshake.Desktop;component/Assets/handshake-icon.png" Width="1100" Height="720" MinWidth="850" MinHeight="560"
        Background="{DynamicResource Ivory}" AllowDrop="True" Drop="Window_Drop">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
      <StackPanel Orientation="Horizontal">
        <Border Width="58" Height="58" CornerRadius="13" Background="White" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="5" Margin="0,0,14,0">
          <Image Source="/Handshake.Desktop;component/Assets/handshake-icon.png" Stretch="Uniform" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Handshake" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Navy}" />
          <TextBlock Text="Build meaningful connections, organized and actionable" FontSize="13" Foreground="{DynamicResource MutedText}" Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>
      <Menu DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="13" Background="Transparent" Margin="16,0,0,0">
        <MenuItem Header="Settings" Click="Settings_Click" />
      </Menu>
    </DockPanel>
    <Border Grid.Row="1" Background="{DynamicResource Mint}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,16">
      <DockPanel LastChildFill="True" VerticalAlignment="Center">
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock Text="ACTIVE CATEGORY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ForestTeal}" />
          <TextBlock x:Name="EventNameText" Text="Current category" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Navy}" Margin="0,2,0,0" />
          <TextBlock x:Name="EventDetailsText" Text="Choose a category or create one to organize your network." FontSize="12" Foreground="{DynamicResource MutedText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <ComboBox x:Name="EventPicker" Width="210" Height="34" Margin="0,0,10,0" SelectionChanged="EventPicker_SelectionChanged" DisplayMemberPath="Name" />
          <Button Content="New category" Padding="15,7" Click="NewEvent_Click" />
          <Button Content="Rename" Padding="11,7" Margin="7,0,0,0" Click="RenameCategory_Click" />
          <Button Content="Delete" Padding="11,7" Margin="7,0,0,0" Click="DeleteCategory_Click" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="2" MinHeight="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
      <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowDrop="True" Drop="Window_Drop">
        <StackPanel AllowDrop="True" Drop="Window_Drop">
        <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="22" AllowDrop="True" Drop="Window_Drop">
        <StackPanel>
          <TextBlock Text="Add contacts" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Navy}" />
          <TextBlock Text="Bring in a business card or contact image from your PC or clipboard. Images are saved automatically with the selected category." TextWrapping="Wrap" Margin="0,8,0,20" Foreground="{DynamicResource MutedText}" />
          <Button Content="Import contacts (CSV, Excel, or vCard)" Padding="18,11" Click="ImportContacts_Click" />
          <Button Content="Choose local images…" Padding="18,11" Click="ChooseImages_Click" />
          <Button Content="Paste image from clipboard" Padding="18,11" Margin="0,10,0,0" Click="PasteImage_Click" />
          <Button Content="Extract contact details" Padding="18,11" Margin="0,10,0,0" Click="Extract_Click" />
          <ProgressBar x:Name="BusyIndicator" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,20,0,0" />
          <TextBlock x:Name="StatusText" Text="No images selected yet." Foreground="#60716D" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        </Border>
        <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Export contacts" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Navy}" />
            <TextBlock Text="Save your network for use in other applications." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,14" />
            <Button Content="Export contacts to CSV" Click="Export_Click" />
            <Button Content="Export contacts to vCard" Margin="0,10,0,0" Click="ExportVcf_Click" />
            <Button Content="Export selected contact to vCard" Margin="0,10,0,0" Click="ExportSelectedVcf_Click" />
            <Button Content="Export contacts to Excel" Margin="0,10,0,0" Click="ExportXlsx_Click" />
          </StackPanel>
        </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="22" MinHeight="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="Contact Imports" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Navy}" />
          <TextBlock Text="Saved source images for this category." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,18" />
          <ListBox x:Name="ImagesList" MinHeight="120" SelectionMode="Single"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,4"><Image Source="{Binding Path}" Width="72" Height="52" Stretch="UniformToFill" Margin="0,0,10,0" /><TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <Button Content="Delete selected image" Padding="12,8" Margin="0,8,0,0" Click="DeleteImage_Click" />
          <TextBlock Text="People in your network" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Navy}" Margin="0,20,0,8" />
          <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Search saved contacts" Margin="0,0,0,8" Padding="8" />
          <ListBox x:Name="ContactsList" MinHeight="120" SelectionMode="Extended" DisplayMemberPath="Name" MouseDoubleClick="ContactsList_DoubleClick" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Edit selected contact" Padding="12,8" HorizontalAlignment="Stretch" Click="EditSelectedContact_Click" />
            <Button Grid.Column="1" Content="Merge duplicates" Padding="12,8" Margin="7,0,0,0" HorizontalAlignment="Stretch" ToolTip="Find and merge duplicate contacts in this category" Click="MergeDuplicates_Click" />
            <Button Grid.Column="2" Content="🗑" FontSize="16" Height="32" Padding="0" Margin="7,0,0,0" ToolTip="Delete selected contact" Click="DeleteContact_Click" />
          </Grid>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
